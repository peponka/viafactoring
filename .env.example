# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (links de avisos, retorno de la pasarela)
NEXT_PUBLIC_SITE_URL=https://viafactoring.vercel.app

# Pasarela de pago: "mock" (pruebas) o "pagopar". Vacío = pago en línea deshabilitado.
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_SECRET=            # cualquier cadena larga; firma los avisos de la pasarela de prueba
PAGOPAR_PUBLIC_KEY=
PAGOPAR_PRIVATE_KEY=

# Proceso programado (/api/cron/tick). Vercel lo manda como "Authorization: Bearer".
CRON_SECRET=

# Email de avisos (Resend). Vacío = solo avisos dentro de la plataforma.
RESEND_API_KEY=
EMAIL_FROM="ViaFactoring <avisos@tudominio.com>"

# IA (Claude): lectura de facturas e investigación de empresas.
# La investigación se guarda una vez por factura con la service role
# (SUPABASE_SERVICE_ROLE_KEY), así no se paga dos veces.
ANTHROPIC_API_KEY=
# Opcionales (por defecto: claude-sonnet-5-5 para leer facturas,
# claude-haiku-5-5 para investigar, que es el más económico)
ANTHROPIC_MODEL_OCR=
ANTHROPIC_MODEL_INVESTIGACION=

# Notificaciones push (Web Push). Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
# Modelos de IA opcionales (moderación del chat y revisión de documentos)
# ANTHROPIC_MODEL_MODERACION=claude-haiku-5-5
# ANTHROPIC_MODEL_DOCS=claude-haiku-5-5
