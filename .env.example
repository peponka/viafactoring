# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (links de avisos, retorno de la pasarela)
NEXT_PUBLIC_SITE_URL=https://viafactoring.vercel.app

# Pasarela de pago: "mock" (pruebas) o "pagopar". Vacío = pago en línea deshabilitado.
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_SECRET=            # cualquier cadena larga; firma los avisos de la pasarela de prueba
PAGOPAR_PUBLIC_KEY=
PAGOPAR_PRIVATE_KEY=

# Proceso programado (/api/cron/tick). Vercel lo manda como "Authorization: Bearer".
CRON_SECRET=

# Email de avisos (Resend). Vacío = solo avisos dentro de la plataforma.
RESEND_API_KEY=
EMAIL_FROM="ViaFactoring <avisos@tudominio.com>"
